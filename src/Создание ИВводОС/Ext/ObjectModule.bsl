// Формирует сведения для регистрации внешней обработки в БСП.
// Регистрирует команду открытия формы и серверную команду фоновой загрузки.
// Возвращаемое значение:
//   Структура - описание обработки, её разрешений и доступных команд.
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Загрузка основных средств и ввод начальных остатков из Excel");
	ПараметрыРегистрации.Вставить("Версия", "2.0.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить("Информация", "Создание основных средств, инвентарных номеров и документов Ввод начальных остатков ОС из Excel.");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "3.1.11.461");
	
	Разрешения = Новый Массив;
	Разрешения.Добавить(РаботаВБезопасномРежиме.РазрешениеНаИспользованиеКаталогаВременныхФайлов(Истина, Истина,));
	// Работа с исходным Excel требует доступа к временным файлам сервера.
	ПараметрыРегистрации.Вставить("Разрешения", Разрешения);
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(ТаблицаКоманд, "Открыть обработку", "ОткрытьФорму", "ОткрытиеФормы", Истина);   
	ДобавитьКоманду(ТаблицаКоманд, "Выполнение загрузки в фоне", "ВыполнитьЗагрузкуВФоне", "ВызовСерверногоМетода", Ложь);
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Создаёт таблицу команд в формате, ожидаемом подсистемой БСП.
// Возвращаемое значение:
//   ТаблицаЗначений - пустая таблица с колонками описания команд.
Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

// Добавляет описание одной команды в таблицу регистрации БСП.
// Параметры:
//   ТаблицаКоманд - таблица команд, которую нужно дополнить.
//   Представление, Идентификатор, Использование - атрибуты команды БСП.
//   ПоказыватьОповещение, Модификатор - необязательные настройки команды.
Процедура ДобавитьКоманду(
	ТаблицаКоманд,
	Представление,
	Идентификатор,
	Использование,
	ПоказыватьОповещение = Ложь,
	Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

// Точка входа серверной команды, вызываемой подсистемой БСП.
// Извлекает параметры из структуры БСП и сохраняет в ней результат загрузки.
// Параметры:
//   ИдентификаторКоманды - ожидается "ВыполнитьЗагрузкуВФоне".
//   ПараметрыВыполнения - параметры и контейнер результата команды.
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполнения) Экспорт

	Если ИдентификаторКоманды <> "ВыполнитьЗагрузкуВФоне" Тогда

		ВызватьИсключение "Неизвестная команда внешней обработки: " + ИдентификаторКоманды;

	КонецЕсли;

	ПараметрыЗагрузки = Неопределено;

	Если Не ПараметрыВыполнения.Свойство("ПараметрыЗагрузки", ПараметрыЗагрузки) Тогда

		ВызватьИсключение "Не переданы параметры загрузки.";

	КонецЕсли;  
	
	РезультатЗагрузки =ВыполнитьЗагрузкуВФоне(ПараметрыЗагрузки);
	
	// Поле читает обработчик завершения фоновой операции в модуле формы.
	ПараметрыВыполнения.РезультатВыполнения = РезультатЗагрузки;

КонецПроцедуры

// Создаёт ОС и его инвентарный номер по одной строке Excel.
// Перед записью проверяет обязательные данные и наличие такого номера.
// Создание обоих элементов выполняется в одной транзакции.
// Параметры:
//   СтрокаДанных - текущая строка подготовленной таблицы Excel.
//   НомерСтроки - её порядковый номер в Excel для сообщений.
//   ПараметрыЗагрузки - общие настройки формы (в частности, организация).
// Возвращаемое значение:
//   Структура - счётчики "СозданоОС", "СозданоИнвНомеров", "Пропущено".
Функция СоздатьОСИИнвентарныйНомерПоСтрокеExcel(СтрокаДанных, НомерСтроки, ПараметрыЗагрузки)

	Результат = Новый Структура;
	Результат.Вставить("СозданоОС", 0);
	Результат.Вставить("СозданоИнвНомеров", 0);
	Результат.Вставить("Пропущено", 0);
	
	// Удаляем служебные переводы строк, начальную точку и повторные пробелы.
	НаименованиеОС = СокрЛП(СтрокаДанных.НаименованиеОС); 
	НаименованиеОС = СтрЗаменить(НаименованиеОС, Символы.ПС, " ");
	НаименованиеОС = СтрЗаменить(НаименованиеОС, Символы.ВК, " ");
	НаименованиеОС = СтрЗаменить(НаименованиеОС, Символы.ВТаб, " ");
	
	Если Лев(НаименованиеОС, 1) = "." Тогда
		НаименованиеОС = СокрЛП(Сред(НаименованиеОС, 2));
	КонецЕсли;
	
	Пока Найти(НаименованиеОС, "  ") > 0 Цикл
		НаименованиеОС = СтрЗаменить(НаименованиеОС, "  ", " ");
	КонецЦикла;

	НаименованиеОС = СокрЛП(НаименованиеОС);
	
	ИнвентарныйНомер = НормализоватьИнвентарныйНомер(СтрокаДанных.ИнвентарныйНомер);

	Если ПустаяСтрока(НаименованиеОС) Тогда
		Результат.Пропущено = 1;
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(ИнвентарныйНомер) Тогда
		ВызватьИсключение "Не заполнен инвентарный номер.";
	КонецЕсли;
	
	// Поиск дубля выполняем до транзакции, чтобы не создавать лишние объекты.
	СуществующийИнвНомер = НайтиИнвентарныйНомер(ПараметрыЗагрузки.Организация, ИнвентарныйНомер);

	Если ЗначениеЗаполнено(СуществующийИнвНомер) Тогда  
		
		Сообщить("Строка " + Строка(НомерСтроки) + ": инвентарный номер " + ИнвентарныйНомер + " уже существует у организации "
				+ Строка(ПараметрыЗагрузки.Организация) + ", строка пропущена.");
		
		Результат.Пропущено = 1;
		Возврат Результат;  
		
	КонецЕсли;
	
	// ОС и инвентарный номер должны записаться вместе или не записаться вовсе.
	НачатьТранзакцию();

	Попытка
	
		НовоеОС = Справочники.ОсновныеСредства.СоздатьЭлемент();

		НовоеОС.Наименование = Лев(НаименованиеОС, 150);
		НовоеОС.Организация = ПараметрыЗагрузки.Организация;
		НовоеОС.ВидНФА = Перечисления.ВидыНФА.ОС;
		НовоеОС.ТипНФА = Перечисления.ТипыНФА.Инвентарь;
		НовоеОС.НаименованиеПолное = НаименованиеОС;
		
		НовоеОС.Записать();

		СсылкаОС = НовоеОС.Ссылка;

		НовыйИнвНомер = Справочники.ИнвентарныеНомераОС.СоздатьЭлемент();

		НовыйИнвНомер.Владелец = ПараметрыЗагрузки.Организация;
		НовыйИнвНомер.ОС = СсылкаОС;
		НовыйИнвНомер.Код = ИнвентарныйНомер;

		НовыйИнвНомер.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ВызватьИсключение "Не удалось создать ОС и инвентарный номер " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			
	КонецПопытки; 
	
	Результат.СозданоОС = 1;
	Результат.СозданоИнвНомеров = 1;
		
	Возврат Результат;

КонецФункции

// Создаёт и проводит документ ввода начальных остатков ОС по строке Excel.
// Проверяет значения, определяет ссылки и пропускает уже существующий документ.
// Создание сотрудника/ЦМО и проведение документа объединены транзакцией.
// Параметры:
//   СтрокаДанных - данные одного ОС из Excel.
//   НомерСтроки - номер строки Excel для диагностических сообщений.
//   КэшСправочныхЗначений - ранее найденные ссылки и документы.
//   ПараметрыЗагрузки - общие реквизиты документов из формы.
// Возвращаемое значение:
//   Структура - счётчики "СозданоДокументов" и "Пропущено".
Функция СоздатьВводОстатковПоСтрокеExcel(СтрокаДанных, НомерСтроки, КэшСправочныхЗначений, ПараметрыЗагрузки)
	
	НаименованиеОС = СокрЛП(СтрокаДанных.НаименованиеОС);
	ИнвентарныйНомер = НормализоватьИнвентарныйНомер(СтрокаДанных.ИнвентарныйНомер);
	КоличествоСтрокой = СокрЛП(СтрокаДанных.Количество);
	БалСтоимостьСтрокой = СокрЛП(СтрокаДанных.БалансоваяСтоимость);
	АмортизацияСтрокой = СокрЛП(СтрокаДанных.Амортизация);
	ОстСтоимостьСтрокой = СокрЛП(СтрокаДанных.ОстаточнаяСтоимость);
	СчетУчетаСтрокой = СокрЛП(СтрокаДанных.СчетУчета);
	ЦМОСтрокой = СокрЛП(СтрокаДанных.ЦМО);
	ДатаПринятияСтрокой = СокрЛП(СтрокаДанных.ДатаПринятияКУчету);
	ДатаВводаСтрокой = СокрЛП(СтрокаДанных.ДатаВводаВЭксплуатацию);
		
     	Результат = Новый Структура;
	Результат.Вставить("СозданоДокументов", 0);
	Результат.Вставить("Пропущено", 0);
     
	Если ПустаяСтрока(НаименованиеОС) Тогда
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(ИнвентарныйНомер) Тогда
		Сообщить("Строка " + НомерСтроки + ": не заполнен инвентарный номер, строка пропущена.");
		Результат.Пропущено = 1;
		Возврат Результат;
	КонецЕсли;
	
	// Приводим текстовые значения Excel к числам до создания документа.
	Количество = ЧислоИзExcel(КоличествоСтрокой);
	БалансоваяСтоимость = ЧислоИзExcel(БалСтоимостьСтрокой);
	Амортизация = ЧислоИзExcel(АмортизацияСтрокой);
	ОстаточнаяСтоимость = ЧислоИзExcel(ОстСтоимостьСтрокой);
	
	Счет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КФО  = Перечисления.КВД.ПустаяСсылка();
	ИФО  = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	
	// Первая цифра счёта задаёт КФО, оставшаяся часть - код счёта ЕПСБУ.
	Если Не ПустаяСтрока(СчетУчетаСтрокой) Тогда
		КФОСтрокой = Лев(СчетУчетаСтрокой, 1);
		СчетСтрокой = Сред(СчетУчетаСтрокой, 2);
		
		Если СтрДлина(СчетСтрокой) = 5 И Найти(СчетСтрокой, ".") = 0 Тогда
		
			СчетСтрокой = Лев(СчетСтрокой, 3) + "." + Прав(СчетСтрокой, 2);
		
		КонецЕсли;
		
		Счет = ПолучитьСчетИзКэша(СчетСтрокой, КэшСправочныхЗначений.Счета);
		
		Если КФОСтрокой = "4" Тогда 
			
			КФО = Перечисления.КВД.СубсидииНаГосзадание;	
			
		ИначеЕсли КФОСтрокой = "2" Тогда   
			
			КФО = Перечисления.КВД.Внебюджет; 			
			
		КонецЕсли; 
		
	ИФО = ПолучитьИФОИзКэша(КФОСтрокой, КэшСправочныхЗначений);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
	    ВызватьИсключение "Не найден счёт учёта: " + СчетУчетаСтрокой;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КФО) Тогда
	    ВызватьИсключение "Не удалось определить КФО по счёту: " + СчетУчетаСтрокой;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ИФО) Тогда
	    ВызватьИсключение "Не удалось определить ИФО по счёту: " + СчетУчетаСтрокой;
	КонецЕсли; 
	
	ДатаПринятияКУчету = ДатаИзСтрокиExcel(ДатаПринятияСтрокой);
	ДатаВводаВЭксплуатацию = ДатаИзСтрокиExcel(ДатаВводаСтрокой);
	
	// Получаем привязку номера к ОС; при отсутствии номера документ не создаём.
	ДанныеИнвентарногоНомера = ПолучитьИнвентарныйНомерИОСИзКэша(ПараметрыЗагрузки.Организация, ИнвентарныйНомер, 
			КэшСправочныхЗначений.ИнвентарныеНомера);

	Если ДанныеИнвентарногоНомера = Неопределено Тогда

		Сообщить("Строка " + Строка(НомерСтроки) + ": не найден инвентарный номер " + ИнвентарныйНомер + " для организации "
				+ Строка(ПараметрыЗагрузки.Организация) + ", строка пропущена.");

		Результат.Пропущено = 1;
		Возврат Результат;

	КонецЕсли;

	СсылкаИнвНомера = ДанныеИнвентарногоНомера.ИнвентарныйНомер;

	СсылкаОС = ДанныеИнвентарногоНомера.ОсновноеСредство;

	Если Не ЗначениеЗаполнено(СсылкаОС) Тогда

		Сообщить("Строка " + Строка(НомерСтроки) + ": у инвентарного номера " + ИнвентарныйНомер
				+ " не заполнено основное средство, строка пропущена.");

		Результат.Пропущено = 1;
		Возврат Результат;

	КонецЕсли;
	
	// Исключаем повторный ввод остатков по уже использованному номеру.
	СуществующийДокумент = КэшСправочныхЗначений.СуществующиеДокументы.Получить(СсылкаИнвНомера);

	Если ЗначениеЗаполнено(СуществующийДокумент) Тогда

		Результат.Пропущено = 1; 
		
		Сообщить("Строка " + Строка(НомерСтроки) + ": для инвентарного номера " + Строка(СсылкаИнвНомера) + " уже существует документ "
	       		+ Строка(СуществующийДокумент) + ", строка пропущена.");
			
		Возврат Результат;

	КонецЕсли; 
	
	НачатьТранзакцию();
	
	Попытка
		
		// ЦМО/сотрудник создаются внутри транзакции документа.
		ЦМО = ПолучитьИлиСоздатьЦМОИзКэша(ПараметрыЗагрузки.Организация, ЦМОСтрокой, КэшСправочныхЗначений.ЦМО, 
			КэшСправочныхЗначений.Сотрудники);
		
		ДокументОстатков = Документы.ВводНачальныхОстатковОС.СоздатьДокумент();

		ДокументОстатков.Дата = ТекущаяДата();
		ДокументОстатков.Организация = ПараметрыЗагрузки.Организация;
		ДокументОстатков.СчетУчета = Счет;
		ДокументОстатков.ИФО = ИФО;
		ДокументОстатков.КПС = ПараметрыЗагрузки.КПС;
		ДокументОстатков.КФО = КФО;     
		ДокументОстатков.ОсновноеСредство = СсылкаОС; 
		ДокументОстатков.ОтражатьВБухгалтерскомУчете = Истина;
				
		Если ЗначениеЗаполнено(ДатаПринятияКУчету) Тогда
			ДокументОстатков.ДатаПринятияКУчету = ДатаПринятияКУчету;
		КонецЕсли;
		
		ДокументОстатков.ДокументПринятияНомер = ПараметрыЗагрузки.НомерДокументаПринятияКУчету;
		ДокументОстатков.ДокументПринятияДата = ПараметрыЗагрузки.ДатаДокументаПринятияКУчету;
		ДокументОстатков.ДокументПринятияВид = ПараметрыЗагрузки.НаименованиеДокументаПринятияКУчету;
		ДокументОстатков.ПервоначальнаяСтоимость = БалансоваяСтоимость;
		ДокументОстатков.ПервоначальнаяСуммаАмортизации = Амортизация;
		// Сохраняем действующее в этой обработке соответствие столбца Excel
		// "ОстаточнаяСтоимость" реквизиту "ПервоначальнаяСуммаОбесценения".
		// Этот комментарий фиксирует правило заполнения, а не тождество показателей.
		ДокументОстатков.ПервоначальнаяСуммаОбесценения = ОстаточнаяСтоимость;
		ДокументОстатков.ПервоначальноеКоличество = Количество;
		
		// Табличная часть содержит инвентарный номер, ЦМО и стоимостные показатели.
		НоваяСтрока = ДокументОстатков.ИнвентарныеОбъекты.Добавить();

		НоваяСтрока.ИнвентарныйНомер = СсылкаИнвНомера;
		НоваяСтрока.ЦМО = ЦМО;  
		
		Если ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
			НоваяСтрока.ДатаВводаВЭксплуатацию = ДатаВводаВЭксплуатацию;
		КонецЕсли;
		
        	НоваяСтрока.ДокументВводаНомер = ПараметрыЗагрузки.НомерДокументаВводаВЭксплуатацию;
        	НоваяСтрока.ДокументВводаДата = ПараметрыЗагрузки.ДатаДокументаВводаВЭксплуатацию;
        	НоваяСтрока.ДокументВводаВид = ПараметрыЗагрузки.НаименованиеДокументаВводаВЭксплуатацию;
		НоваяСтрока.СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию");
		НоваяСтрока.НаСчете21 = Ложь;  
		НоваяСтрока.Количество = Количество;
		НоваяСтрока.Стоимость = БалансоваяСтоимость;
		НоваяСтрока.СуммаАмортизации = Амортизация;
		НоваяСтрока.СуммаОбесценения = ОстаточнаяСтоимость;
		
         	// Настраиваем порядок погашения стоимости в отдельной табличной части.
         	НоваяСтрока = ДокументОстатков.СтоимостьИАмортизация.Добавить();
        	НоваяСтрока.ПорядокПогашенияСтоимости = ПараметрыЗагрузки.ПорядокПогашенияСтоимости;  
			
		// Заполняем реквизиты типовой бухгалтерской операции перед проведением.
		ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатковОС_ВводНачальныхОстатковОС;
		ДополнительныеРеквизиты = Новый Структура;
		БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(ДокументОстатков, ТиповаяОперация, ДополнительныеРеквизиты, Истина);
		
		ДокументОстатков.Записать(РежимЗаписиДокумента.Запись);
		
		// Формируем проводки по уже записанному документу; отказ прерывает транзакцию.
		ТаблицаПроводок = Обработки.ФормированиеБухгалтерскихПроводок.СформироватьТаблицуПроводок(ДокументОстатков.Ссылка);
		Если ТаблицаПроводок <> Неопределено И ТаблицаПроводок.Количество() > 0 Тогда
			Отказ = Ложь;
			БухгалтерскиеОперацииСервер.ЗагрузитьПроводкиДокумента(ДокументОстатков.Ссылка, ТаблицаПроводок, Отказ); 
			
			Если Отказ Тогда
				ВызватьИсключение "Не удалось загрузить бухгалтерские проводки документа.";
		    	КонецЕсли;
			
		КонецЕсли;

		ДокументОстатков.Записать(РежимЗаписиДокумента.Проведение);  

		ЗафиксироватьТранзакцию();   
		
	Исключение
		
		ИнформацияТекущейОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Если ТранзакцияАктивна() Тогда
        		ОтменитьТранзакцию();
    		КонецЕсли;
			
		// При откате записи базы отменяются, а ссылки в кэшах - нет.
		// Удаляем потенциально недействительные ссылки на ЦМО/сотрудников.
		КэшСправочныхЗначений.ЦМО.Очистить();
        	КэшСправочныхЗначений.Сотрудники.Очистить();	
			
		ВызватьИсключение "Не удалось создать документ ввода остатков " + ИнформацияТекущейОшибки;
				
	КонецПопытки; 
	
	// Обновляем кэш только после фиксации: следующая строка увидит новый документ.
	КэшСправочныхЗначений.СуществующиеДокументы.Вставить(СсылкаИнвНомера, ДокументОстатков.Ссылка);
	
	Результат.СозданоДокументов = 1; 
	
	Возврат Результат; 
	
КонецФункции

// Получает счёт ЕПСБУ по коду, повторно используя результат поиска.
// Параметры:
//   КодСчета - код счёта без начальной цифры КФО.
//   КэшСчетов - соответствие "код -> структура со ссылкой".
// Возвращаемое значение:
//   Ссылка на счёт (или пустая ссылка, если счёт не найден).
Функция ПолучитьСчетИзКэша(КодСчета, КэшСчетов)

	КлючКэша = СокрЛП(КодСчета);

	Если ПустаяСтрока(КлючКэша) Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	// Обёртка со значением нужна также для кэширования пустой ссылки.
	ЭлементКэша = КэшСчетов.Получить(КлючКэша);

	Если ЭлементКэша <> Неопределено Тогда
		Возврат ЭлементКэша.Значение;
	КонецЕсли;

	СсылкаСчета = ПланыСчетов.ЕПСБУ.НайтиПоКоду(КлючКэша);

	КэшСчетов.Вставить(КлючКэша, Новый Структура("Значение", СсылкаСчета));

	Возврат СсылкаСчета;

КонецФункции

// Определяет источник финансового обеспечения по цифре КФО.
// Для КФО "4" и "2" сохраняет результаты поиска на время загрузки.
// Возвращаемое значение:
//   Ссылка на ИФО или пустая ссылка при неизвестном КФО.
Функция ПолучитьИФОИзКэша(КФОСтрокой, КэшСправочныхЗначений)

	Если КФОСтрокой = "4" Тогда

		Если КэшСправочныхЗначений.ИФОГосзадание = Неопределено Тогда

			КэшСправочныхЗначений.ИФОГосзадание = Справочники.ИсточникиФинансовогоОбеспечения.НайтиПоНаименованию(
						"Субсидии на выполнение государственного задания", Истина);

		КонецЕсли;

		Возврат КэшСправочныхЗначений.ИФОГосзадание;

	ИначеЕсли КФОСтрокой = "2" Тогда

		Если КэшСправочныхЗначений.ИФОВнебюджет = Неопределено Тогда

			КэшСправочныхЗначений.ИФОВнебюджет = Справочники.ИсточникиФинансовогоОбеспечения.НайтиПоНаименованию(
						"Приносящая доход деятельность", Истина);

		КонецЕсли;

		Возврат КэшСправочныхЗначений.ИФОВнебюджет;

	КонецЕсли;

	Возврат
		Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();

	КонецФункции
	
// Находит ЦМО организации по наименованию или создаёт его при отсутствии.
// При создании ЦМО также получает/создаёт соответствующего сотрудника.
// ВАЖНО: функция может записывать объекты базы; вызывающий код должен включать её в транзакцию вместе с документом ввода 
// остатков.
// Возвращаемое значение:
//   Ссылка на ЦМО либо пустая ссылка при пустом наименовании.
Функция ПолучитьИлиСоздатьЦМОИзКэша(ОрганизацияПоиска, НаименованиеЦМО, КэшЦМО, КэшСотрудников)

	НаименованиеЦМО = СокрЛП(НаименованиеЦМО);

	Если ПустаяСтрока(НаименованиеЦМО) Тогда
		Возврат Справочники.ЦМО.ПустаяСсылка();
	КонецЕсли;

	КлючКэша = ВРег(НаименованиеЦМО);

	ЭлементКэша = КэшЦМО.Получить(КлючКэша);

	Если ЭлементКэша <> Неопределено Тогда
		Возврат ЭлементКэша.Значение;
	КонецЕсли;

	ЦМОСсылка = НайтиЦМОПоОрганизации(ОрганизацияПоиска, НаименованиеЦМО);

	Если Не ЗначениеЗаполнено(ЦМОСсылка) Тогда

		СотрудникСсылка = ПолучитьИлиСоздатьСотрудникаИзКэша(ОрганизацияПоиска, НаименованиеЦМО, КэшСотрудников);

		НовыйЦМО = Справочники.ЦМО.СоздатьЭлемент();
		НовыйЦМО.Наименование = НаименованиеЦМО;
		НовыйЦМО.Владелец = ОрганизацияПоиска;
		НовыйЦМО.Сотрудник = СотрудникСсылка;
		НовыйЦМО.Записать();

		ЦМОСсылка = НовыйЦМО.Ссылка;

	КонецЕсли;

	КэшЦМО.Вставить(КлючКэша, Новый Структура("Значение", ЦМОСсылка));

	Возврат ЦМОСсылка;

КонецФункции       

// Возвращает инвентарный номер и связанное ОС с кэшированием поиска.
// Кэш хранит и отсутствие данных (через структуру с полем "Значение").
// Возвращаемое значение:
//   Структура "ИнвентарныйНомер, ОсновноеСредство" либо Неопределено.
Функция ПолучитьИнвентарныйНомерИОСИзКэша(ОрганизацияПоиска, КодИнвентарногоНомера, КэшИнвентарныхНомеров)

	КлючКэша = СокрЛП(КодИнвентарногоНомера);
	
	// Через структуру кэшируем как найденный номер, так и Неопределено.
	ЭлементКэша = КэшИнвентарныхНомеров.Получить(КлючКэша);

	Если ЭлементКэша <> Неопределено Тогда
		Возврат ЭлементКэша.Значение;
	КонецЕсли;

	ДанныеИнвентарногоНомера = ПолучитьИнвентарныйНомерИОС(ОрганизацияПоиска, КодИнвентарногоНомера);

	КэшИнвентарныхНомеров.Вставить(КлючКэша, Новый Структура("Значение",ДанныеИнвентарногоНомера));

	Возврат ДанныеИнвентарногоНомера;

КонецФункции

// Ищет инвентарный номер по организации и коду, исключая помеченные.
// Возвращаемое значение:
//   Структура со ссылкой номера и ОС либо Неопределено.
Функция ПолучитьИнвентарныйНомерИОС(ОрганизацияПоиска, КодИнвентарногоНомера)

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер,
	|	ИнвентарныеНомераОС.ОС КАК ОсновноеСредство
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Владелец = &Организация
	|	И ИнвентарныеНомераОС.Код = &Код
	|	И НЕ ИнвентарныеНомераОС.ПометкаУдаления";

	Запрос.УстановитьПараметр("Организация", ОрганизацияПоиска);

	Запрос.УстановитьПараметр("Код", КодИнвентарногоНомера);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("ИнвентарныйНомер, ОсновноеСредство", Выборка.ИнвентарныйНомер, Выборка.ОсновноеСредство);

КонецФункции

// Проверяет наличие инвентарного номера у указанной организации.
// Используется в режиме создания ОС для предотвращения повторного ввода.
// Возвращаемое значение:
//   Ссылка на номер либо Неопределено.
Функция НайтиИнвентарныйНомер(ОрганизацияПоиска, КодИнвентарногоНомера)

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнвентарныеНомераОС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Владелец = &Организация
	|	И ИнвентарныеНомераОС.Код = &Код
	|	И НЕ ИнвентарныеНомераОС.ПометкаУдаления";

	Запрос.УстановитьПараметр("Организация", ОрганизацияПоиска);

	Запрос.УстановитьПараметр("Код", КодИнвентарногоНомера);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Преобразует текст ячейки Excel в число.
// Удаляет обычные/неразрывные пробелы и приводит десятичный разделитель.
// Пустая ячейка считается нулём; неправильный формат вызывает исключение.
Функция ЧислоИзExcel(ЗначениеЯчейки)

	СтрокаЧисла = СокрЛП(Строка(ЗначениеЯчейки));

	Если ПустаяСтрока(СтрокаЧисла) Тогда
		Возврат 0;
	КонецЕсли;

	СтрокаЧисла = СтрЗаменить(СтрокаЧисла, " ", "");
	СтрокаЧисла = СтрЗаменить(СтрокаЧисла, Символ(160), "");

	СтрокаЧисла = СтрЗаменить(СтрокаЧисла, ".", ",");

	Попытка
		Возврат Число(СтрокаЧисла);
	Исключение
		ВызватьИсключение "Не удалось преобразовать значение """ + Строка(ЗначениеЯчейки) + """ в число.";
	КонецПопытки;

КонецФункции  

// Преобразует дату из Excel в формате день.месяц.год.
// Разделители "/" и "-" предварительно заменяются на точку.
// Пустая ячейка или "нет" означает пустую дату; неверный формат - ошибка.
Функция ДатаИзСтрокиExcel(Знач СтрДата)
	
	СтрДата = СокрЛП(СтрДата);
	Если ПустаяСтрока(СтрДата) Или НРег(СтрДата) = "нет" Тогда
		Возврат '00010101';
	КонецЕсли;
	
	СтрДата = СтрЗаменить(СтрДата, "/", ".");
	СтрДата = СтрЗаменить(СтрДата, "-", ".");
	
	Части = СтрРазделить(СтрДата, ".");
	Если Части.Количество() >= 3 Тогда
		Попытка
			Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
		Исключение
			ВызватьИсключение "Некорректная дата в Excel: """ + СтрДата + """.";
		КонецПопытки;
	КонецЕсли;
	
	ВызватьИсключение "Неверный формат даты в Excel: """ + СтрДата + """.";
	
КонецФункции

// Основной серверный обработчик фоновой загрузки Excel.
// Получает строку данных исходного файла, читает его в ТабДок, формирует таблицу строк, подготавливает кэш и обрабатывает 
// записи.
// Не останавливает всю загрузку при ошибке отдельной строки.
// Возвращаемое значение:
//   Структура - режим, счётчики обработки и массив текстов ошибок.
Функция ВыполнитьЗагрузкуВФоне(ПараметрыЗагрузки)
	
	ДанныеExcelСтрокой = "";

	Если Не ПараметрыЗагрузки.Свойство("ДанныеExcelСтрокой", ДанныеExcelСтрокой) Или ПустаяСтрока(ДанныеExcelСтрокой) Тогда

		ВызватьИсключение "Не переданы подготовленные данные Excel.";

	КонецЕсли;

	Попытка
		// Читаем сериализованную таблицу строк.
		ТаблицаДанных = ЗначениеИзСтрокиВнутр(ДанныеExcelСтрокой);
	Исключение
		ВызватьИсключение "Не удалось восстановить данные Excel: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если ТипЗнч(ТаблицаДанных) <> Тип("ТаблицаЗначений") Тогда

		ВызватьИсключение "Подготовленные данные Excel имеют неверный тип: " + Строка(ТипЗнч(ТаблицаДанных));

	КонецЕсли;
	
	// В итоговую статистику входят строки, фактически подготовленные из Excel.
	ВсегоСтрок = ТаблицаДанных.Количество();

	Результат = Новый Структура;

	Результат.Вставить("Режим", ПараметрыЗагрузки.Режим);
	Результат.Вставить("СозданоОС", 0);
	Результат.Вставить("СозданоИнвНомеров", 0);
	Результат.Вставить("СозданоДокументов", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Ошибок", 0);
	Результат.Вставить("ТекстыОшибок", Новый Массив);

	Если ВсегоСтрок = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	КэшСправочныхЗначений = Неопределено;

	Если ПараметрыЗагрузки.Режим = "Остатки" Тогда
		
		КэшСправочныхЗначений = СоздатьКэшСправочныхЗначений();  
		
		// Один предварительный запрос вместо поиска дубля в каждой строке.
		ЗаполнитьКэшСуществующихДокументов(ТаблицаДанных, ПараметрыЗагрузки.Организация, 
				КэшСправочныхЗначений.СуществующиеДокументы);
				
	КонецЕсли;
	
	ДлительныеОперации.СообщитьПрогресс(0, "Подготовка к загрузке...");

	Для ИндексСтроки = 0 По ВсегоСтрок - 1 Цикл

		// +2: индекс в таблице с нуля, первая строка Excel - заголовок.
		// Такой расчёт верен, пока промежуточные строки не отбрасываются.
		НомерСтрокиExcel = ИндексСтроки + 2;

		СтрокаДанных = ТаблицаДанных[ИндексСтроки];

		Попытка

			Если ПараметрыЗагрузки.Режим = "ОС" Тогда

				РезультатСтроки = СоздатьОСИИнвентарныйНомерПоСтрокеExcel(СтрокаДанных, НомерСтрокиExcel, ПараметрыЗагрузки);

				Результат.СозданоОС = Результат.СозданоОС + РезультатСтроки.СозданоОС;
				Результат.СозданоИнвНомеров = Результат.СозданоИнвНомеров + РезультатСтроки.СозданоИнвНомеров;

			ИначеЕсли ПараметрыЗагрузки.Режим = "Остатки" Тогда

				РезультатСтроки = СоздатьВводОстатковПоСтрокеExcel(
						СтрокаДанных,
						НомерСтрокиExcel,
						КэшСправочныхЗначений,
						ПараметрыЗагрузки);

				Результат.СозданоДокументов = Результат.СозданоДокументов + РезультатСтроки.СозданоДокументов;

			Иначе

				ВызватьИсключение "Неизвестный режим загрузки: " + ПараметрыЗагрузки.Режим;

			КонецЕсли;

			Результат.Пропущено = Результат.Пропущено + РезультатСтроки.Пропущено;

		Исключение

			Результат.Ошибок = Результат.Ошибок + 1;

			Результат.ТекстыОшибок.Добавить("Ошибка в строке Excel " + Строка(НомерСтрокиExcel) + ": " 
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

		Обработано = ИндексСтроки + 1;
		
		// Обновляем прогресс не на каждой строке, чтобы не создавать лишних вызовов.
		Если Обработано % 10 = 0 Или Обработано = ВсегоСтрок Тогда

			Процент = Окр(Обработано / ВсегоСтрок * 100, 0);

			Если ПараметрыЗагрузки.Режим = "ОС" Тогда

				ТекстПрогресса = "Создание ОС: " + Строка(Обработано) + " из " + Строка(ВсегоСтрок);

			Иначе

				ТекстПрогресса = "Создание документов: " + Строка(Обработано) + " из " + Строка(ВсегоСтрок);

			КонецЕсли;

			ДлительныеОперации.СообщитьПрогресс(Процент, ТекстПрогресса);

		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ищет непомеченный ЦМО в заданной организации по наименованию.
// Возвращаемое значение:
//   Ссылка на ЦМО либо пустая ссылка при отсутствии результата.
Функция НайтиЦМОПоОрганизации(ОрганизацияПоиска, НаименованиеЦМО)

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЦМО.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЦМО КАК ЦМО
	|ГДЕ
	|	ЦМО.Владелец = &Организация
	|	И ЦМО.Наименование = &Наименование
	|	И НЕ ЦМО.ПометкаУдаления";

	Запрос.УстановитьПараметр("Организация", ОрганизацияПоиска);
	Запрос.УстановитьПараметр("Наименование", НаименованиеЦМО);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.ЦМО.ПустаяСсылка();

КонецФункции

// Возвращает сотрудника организации по наименованию с кэшированием.
// При отсутствии создаёт новый элемент справочника "Сотрудники".
// ВАЖНО: запись должна выполняться внутри транзакции вызывающего кода.
// Возвращаемое значение:
//   Ссылка на сотрудника либо пустая ссылка при пустом наименовании.
Функция ПолучитьИлиСоздатьСотрудникаИзКэша(ОрганизацияПоиска, НаименованиеСотрудника, КэшСотрудников)

	НаименованиеСотрудника = СокрЛП(НаименованиеСотрудника);

	Если ПустаяСтрока(НаименованиеСотрудника) Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;

	КлючКэша = ВРег(НаименованиеСотрудника);

	ЭлементКэша = КэшСотрудников.Получить(КлючКэша);

	Если ЭлементКэша <> Неопределено Тогда
		Возврат ЭлементКэша.Значение;
	КонецЕсли;

	СотрудникСсылка = НайтиСотрудникаПоОрганизации(ОрганизацияПоиска, НаименованиеСотрудника);

	Если Не ЗначениеЗаполнено(СотрудникСсылка) Тогда

		НовыйСотрудник = Справочники.Сотрудники.СоздатьЭлемент();

		НовыйСотрудник.Наименование = НаименованиеСотрудника;
		НовыйСотрудник.Владелец = ОрганизацияПоиска;
		НовыйСотрудник.Записать();

		СотрудникСсылка = НовыйСотрудник.Ссылка;

	КонецЕсли;

	КэшСотрудников.Вставить(КлючКэша, Новый Структура("Значение", СотрудникСсылка));

	Возврат СотрудникСсылка;

КонецФункции

// Ищет непомеченного сотрудника организации по наименованию.
// Возвращаемое значение:
//   Ссылка на сотрудника либо пустая ссылка, если он не найден.
Функция НайтиСотрудникаПоОрганизации(ОрганизацияПоиска, НаименованиеСотрудника)

