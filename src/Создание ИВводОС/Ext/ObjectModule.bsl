КонецФункции

// Создаёт кэши, общие для всех строк текущей фоновой загрузки остатков.
// Счета, сотрудники, ЦМО, номера и документы хранятся в соответствиях;
// отдельные поля ИФО заполняются по мере первого обращения.
// Возвращаемое значение:
//   Структура со всеми кэшами и полями ИФО.
Функция СоздатьКэшСправочныхЗначений()

	КэшСправочныхЗначений = Новый Структура;

	КэшСправочныхЗначений.Вставить("Счета", Новый Соответствие);
	КэшСправочныхЗначений.Вставить("ЦМО", Новый Соответствие);
	КэшСправочныхЗначений.Вставить("Сотрудники", Новый Соответствие);
	КэшСправочныхЗначений.Вставить("ИнвентарныеНомера", Новый Соответствие);
	КэшСправочныхЗначений.Вставить("СуществующиеДокументы", Новый Соответствие);
	КэшСправочныхЗначений.Вставить("ИФОГосзадание", Неопределено);
	КэшСправочныхЗначений.Вставить("ИФОВнебюджет", Неопределено); 

	Возврат КэшСправочныхЗначений;

КонецФункции

// Приводит инвентарный номер из Excel к формату поиска в справочнике.
// Удаляет пробелы, в том числе неразрывные, и табуляции;
// непустые номера короче 10 символов дополняет слева нулями.
// Возвращаемое значение:
//   Строка - нормализованный инвентарный номер.
Функция НормализоватьИнвентарныйНомер(ЗначениеИнвентарногоНомера)

    Результат = СокрЛП(Строка(ЗначениеИнвентарногоНомера));
    Результат = СтрЗаменить(Результат, Символ(160), "");
    Результат = СтрЗаменить(Результат, " ", "");
    Результат = СтрЗаменить(Результат, Символы.Таб, "");

    Если Не ПустаяСтрока(Результат) И СтрДлина(Результат) < 10 Тогда

        Результат = Прав("0000000000" + Результат, 10);

    КонецЕсли;

    Возврат Результат;

КонецФункции

// Одним запросом загружает документы остатков по номерам из Excel.
// Перед запросом нормализует номера и удаляет повторения.
// Кэш использует ссылку инвентарного номера как ключ; для совпадений сохраняет первый найденный документ.
// Параметры:
//   ТаблицаДанных - подготовленные строки Excel.
//   Организация - организация, по которой выполняется поиск.
//   КэшДокументов - соответствие для заполнения найденными ссылками.
Процедура ЗаполнитьКэшСуществующихДокументов(ТаблицаДанных, Организация, КэшДокументов)

    МассивКодов = Новый Массив;
    УникальныеКоды = Новый Соответствие;

    Для Каждого СтрокаДанных Из ТаблицаДанных Цикл

	  ИнвентарныйНомер = НормализоватьИнвентарныйНомер(СтрокаДанных.ИнвентарныйНомер);

        Если ПустаяСтрока(ИнвентарныйНомер) Тогда
            Продолжить;
        КонецЕсли;

        Если УникальныеКоды.Получить(ИнвентарныйНомер) = Неопределено Тогда

            УникальныеКоды.Вставить(ИнвентарныйНомер, Истина);

            МассивКодов.Добавить(ИнвентарныйНомер);

        КонецЕсли;

    КонецЦикла;
	
    // При отсутствии номеров запрос к базе не требуется.
    Если МассивКодов.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ
    |	ИнвентарныеНомера.Ссылка КАК ИнвентарныйНомер,
    |	ИнвентарныеОбъекты.Ссылка КАК ДокументОстатков
    |ИЗ
    |	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомера
    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатковОС.ИнвентарныеОбъекты КАК ИнвентарныеОбъекты
    |		ПО (ИнвентарныеОбъекты.ИнвентарныйНомер = ИнвентарныеНомера.Ссылка)
    |			И (ИнвентарныеОбъекты.Ссылка.Организация = &Организация)
    |			И (ИнвентарныеОбъекты.Ссылка.ОсновноеСредство = ИнвентарныеНомера.ОС)
    |			И (НЕ ИнвентарныеОбъекты.Ссылка.ПометкаУдаления)
    |ГДЕ
    |	ИнвентарныеНомера.Владелец = &Организация
    |	И ИнвентарныеНомера.Код В(&Коды)
    |	И НЕ ИнвентарныеНомера.ПометкаУдаления";

    Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.УстановитьПараметр("Коды", МассивКодов);

    Выборка =Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл
		
        // При нескольких подходящих документах используем первый из выборки.
        Если КэшДокументов.Получить(Выборка.ИнвентарныйНомер) = Неопределено Тогда

            КэшДокументов.Вставить(Выборка.ИнвентарныйНомер, Выборка.ДокументОстатков);

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры