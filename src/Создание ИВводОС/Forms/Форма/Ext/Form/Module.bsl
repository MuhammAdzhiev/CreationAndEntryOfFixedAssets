
&НаКлиенте
Процедура Загрузить(Команда)
    
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Сначала выберите организацию.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"ПослеПомещенияФайла",
		ЭтотОбъект
	);

	Попытка

			НачатьПомещениеФайла(
			Оповещение,
			,
			,
			Истина,
			УникальныйИдентификатор
		);

	Исключение

		Сообщить("Ошибка при НачатьПомещениеФайла: " + ОписаниеОшибки());

	КонецПопытки;
		
КонецПроцедуры
 
&НаКлиенте
Процедура ПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Сообщить("Файл не был выбран.");
		Возврат;
	КонецЕсли;

	Попытка
		ДанныеЗагрузки = ПодготовитьExcelКПошаговойЗагрузкеНаСервере(Адрес);
	Исключение
		Сообщить("Ошибка подготовки Excel: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	АдресТабДокДляЗагрузки = ДанныеЗагрузки.АдресТабДок;
	ПоследняяСтрокаExcel = ДанныеЗагрузки.ПоследняяСтрока;
	ВсегоСтрокДляПрогресса = ДанныеЗагрузки.ВсегоСтрок;

	ТекущаяСтрокаExcel = 2;
	ОбработаноСтрок = 0;
	ПроцентЗагрузки = 0;
	РазмерПачки = 100;

	РежимЗагрузки = "ОС"; 
	
	СозданоОС = 0;
	СозданоИнвНомеров = 0;
	СозданоДокументовОстатков = 0;
	ПропущеноСтрок = 0;
	ОшибокЗагрузки = 0;
	
	ТекстПрогресса = "Начинаю создание ОС и инвентарных номеров...";

	ПодключитьОбработчикОжидания("ВыполнитьШагЗагрузки", 0.1, Истина);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОсновныеСредстваНаСервере(АдресФайла)

	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);

	Если ДвоичныеДанныеФайла = Неопределено Тогда
		Сообщить("Не удалось получить файл из временного хранилища.");
		Возврат;
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);

	ТабДок = Новый ТабличныйДокумент;

	Попытка
		ТабДок.Прочитать(ИмяВременногоФайла);
	Исключение
		Сообщить("Не удалось прочитать Excel: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	СозданоОС = 0;
	СозданоИнвНомеров = 0;
	Пропущено = 0;
	Ошибок = 0;
         
	Для НомерСтроки = 2 По ТабДок.ВысотаТаблицы Цикл
                 
		Попытка

			СоздатьОСИИнвентарныйНомерПоСтрокеExcel(ТабДок, НомерСтроки);

		Исключение

			Ошибок = Ошибок + 1;
			Сообщить("Ошибка создания ОС в строке " 
				+ НомерСтроки + ": " + ОписаниеОшибки());

		КонецПопытки;

		Обработано = Обработано + 1;
		
	КонецЦикла;

	Сообщить("Готово.");
	Сообщить("Создано ОС: " + СозданоОС);
	Сообщить("Создано инвентарных номеров: " + СозданоИнвНомеров);
	Сообщить("Пропущено: " + Пропущено);
	Сообщить("Ошибок: " + Ошибок);
    	
КонецПроцедуры

&НаСервере
Функция НайтиИнвентарныйНомер(ИнвентарныйНомер)

	Попытка
		СсылкаПоКоду = Справочники.ИнвентарныеНомераОС.НайтиПоКоду(ИнвентарныйНомер);

		Если ЗначениеЗаполнено(СсылкаПоКоду) Тогда
			Возврат СсылкаПоКоду;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ЕстьРеквизитОбъекта(Объект, ИмяРеквизита)

	МетаданныеОбъекта = Объект.Метаданные();

	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		Если Реквизит.Имя = ИмяРеквизита Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура СоздатьВводОстатков(Команда)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Сначала выберите организацию.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИФО) Тогда
		Сообщить("Сначала выберите ИФО.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КПС) Тогда
		Сообщить("Сначала выберите КПС.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КФО) Тогда
		Сообщить("Сначала выберите КФО.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Счет) Тогда
		Сообщить("Сначала выберите счет.");
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ПорядокПогашенияСтоимости) Тогда
		Сообщить("Сначала выберите порядок погашения стоимости.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"ПослеПомещенияФайлаДляВводаОстатков",
		ЭтотОбъект);

	Попытка

		НачатьПомещениеФайла(
			Оповещение,
			,
			,
			Истина,
			УникальныйИдентификатор);

	Исключение
		Сообщить("Ошибка при передаче файла: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

