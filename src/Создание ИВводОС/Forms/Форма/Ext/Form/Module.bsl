КонецФункции

&НаСервере
Функция ПолучитьОсновноеСредствоИзИнвентарногоНомера(СсылкаИнвНомера)

	Если Не ЗначениеЗаполнено(СсылкаИнвНомера) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбъектИнвНомера = СсылкаИнвНомера.ПолучитьОбъект();

	Для Каждого РеквизитМД Из ОбъектИнвНомера.Метаданные().Реквизиты Цикл

		Если РеквизитМД.Тип.СодержитТип(Тип("СправочникСсылка.ОсновныеСредства")) Тогда

			ИмяРеквизита = РеквизитМД.Имя;
			ЗначениеОС = ОбъектИнвНомера[ИмяРеквизита];

			Если ЗначениеЗаполнено(ЗначениеОС) Тогда
				Возврат ЗначениеОС;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура СоздатьВводНачальныхОстатковНаСервере(АдресФайла)

	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);

	Если ДвоичныеДанныеФайла = Неопределено Тогда
		Сообщить("Не удалось получить Excel-файл из временного хранилища.");
		Возврат;
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);

	ТабДок = Новый ТабличныйДокумент;

	Попытка
		ТабДок.Прочитать(ИмяВременногоФайла);
	Исключение
		Сообщить("Не удалось прочитать Excel: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	СозданоДокументов = 0;
	Ошибок = 0;
	Пропущено = 0;
          
	Для НомерСтроки = 2 По ТабДок.ВысотаТаблицы Цикл
        
       Попытка

		СоздатьВводОстатковПоСтрокеExcel(ТабДок, НомерСтроки);

		Исключение

			Ошибок = Ошибок + 1;
			Сообщить("Ошибка создания ввода остатков в строке " 
				+ НомерСтроки + ": " + ОписаниеОшибки());

		КонецПопытки;

		Обработано = Обработано + 1; 	
        	
	КонецЦикла;

	Сообщить("Готово.");
	Сообщить("Создано документов: " + СозданоДокументов);
	Сообщить("Пропущено: " + Пропущено);
	Сообщить("Ошибок: " + Ошибок);
    
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтоимостьВШапке(Объект, БалансоваяСтоимость, Амортизация, ОстаточнаяСтоимость, Количество)

	УстановитьРеквизитЕслиЕсть(Объект, "ПервоначальнаяСтоимость", БалансоваяСтоимость);

	УстановитьРеквизитЕслиЕсть(Объект, "ПервоначальнаяСуммаАмортизации", Амортизация);

	УстановитьРеквизитЕслиЕсть(Объект, "ПервоначальнаяСуммаОбесценения", ОстаточнаяСтоимость);

	УстановитьРеквизитЕслиЕсть(Объект, "ПервоначальноеКоличество", Количество);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтоимостьВСтрокеИнвОбъекты(СтрокаТЧ, БалансоваяСтоимость, Амортизация, ОстаточнаяСтоимость, Количество)

	УстановитьРеквизитЕслиЕсть(СтрокаТЧ, "Количество", Количество);

	УстановитьРеквизитЕслиЕсть(СтрокаТЧ, "Стоимость", БалансоваяСтоимость);

	УстановитьРеквизитЕслиЕсть(СтрокаТЧ, "СуммаАмортизации", Амортизация);

	УстановитьРеквизитЕслиЕсть(СтрокаТЧ, "СуммаОбесценения", ОстаточнаяСтоимость);  
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитЕслиЕсть(Объект, ИмяРеквизита, Значение)

	Попытка
		Объект[ИмяРеквизита] = Значение;
	Исключение
		// Если такого реквизита нет — просто пропускаем.
		// Это нужно, чтобы обработка не падала на полях,
		// которые в твоей БГУ называются иначе или находятся не здесь.
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПодготовитьExcelКПошаговойЗагрузкеНаСервере(АдресФайла)

	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);

	Если ДвоичныеДанныеФайла = Неопределено Тогда
		ВызватьИсключение "Не удалось получить Excel-файл из временного хранилища.";
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);

	ТабДок = Новый ТабличныйДокумент;

	Попытка
		ТабДок.Прочитать(ИмяВременногоФайла);
	Исключение
		ВызватьИсключение "Не удалось прочитать Excel: " + ОписаниеОшибки();
	КонецПопытки;

	АдресТабДок = ПоместитьВоВременноеХранилище(ТабДок, УникальныйИдентификатор);

	Результат = Новый Структура;
	Результат.Вставить("АдресТабДок", АдресТабДок);
	Результат.Вставить("ПоследняяСтрока", ТабДок.ВысотаТаблицы);
	Результат.Вставить("ВсегоСтрок", ТабДок.ВысотаТаблицы - 1);

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ВыполнитьШагЗагрузки() Экспорт

	Если ТекущаяСтрокаExcel > ПоследняяСтрокаExcel Тогда

		ПроцентЗагрузки = 100;

		Если РежимЗагрузки = "ОС" Тогда
			ТекстПрогресса = "Создание ОС и инвентарных номеров завершено.";
			Сообщить("Создано ОС: " + Строка(СозданоОС) + Символы.ПС);
			Сообщить("Создано инвентарных номеров: " + Строка(СозданоИнвНомеров) + Символы.ПС);
			Сообщить("Пропущено строк: " + Строка(ПропущеноСтрок) + Символы.ПС);
			Сообщить("Ошибок: " + Строка(ОшибокЗагрузки));
			
		ИначеЕсли РежимЗагрузки = "Остатки" Тогда
			ТекстПрогресса = "Создание документов ввода остатков завершено."; 
			Сообщить(
				"Создано документов: " + Строка(СозданоДокументовОстатков) + Символы.ПС
				+ "Пропущено строк: " + Строка(ПропущеноСтрок) + Символы.ПС
				+ "Ошибок: " + Строка(ОшибокЗагрузки)
			);
			
		Иначе
			
			ТекстПрогресса = "Загрузка завершена.";
		    	Сообщить(ТекстПрогресса);

		КонецЕсли;

		Возврат;

	КонецЕсли;

	Попытка

		Если РежимЗагрузки = "ОС" Тогда

			РезультатПачки = ОбработатьПачкуОСНаСервере(
				АдресТабДокДляЗагрузки,
				ТекущаяСтрокаExcel,
				РазмерПачки
			);
			
			СозданоОС = СозданоОС + РезультатПачки.СозданоОС;
			СозданоИнвНомеров = СозданоИнвНомеров + РезультатПачки.СозданоИнвНомеров;
			ПропущеноСтрок = ПропущеноСтрок + РезультатПачки.Пропущено;
			ОшибокЗагрузки = ОшибокЗагрузки + РезультатПачки.Ошибок;

		ИначеЕсли РежимЗагрузки = "Остатки" Тогда

			РезультатПачки = ОбработатьПачкуВводаОстатковНаСервере(
				АдресТабДокДляЗагрузки,
				ТекущаяСтрокаExcel,
				РазмерПачки
			); 
			
			СозданоДокументовОстатков = СозданоДокументовОстатков + РезультатПачки.СозданоДокументов;
			ПропущеноСтрок = ПропущеноСтрок + РезультатПачки.Пропущено;
			ОшибокЗагрузки = ОшибокЗагрузки + РезультатПачки.Ошибок;

		Иначе

			Сообщить("Неизвестный режим загрузки: " + РежимЗагрузки);
			Возврат;

		КонецЕсли;

	Исключение

		Сообщить("Ошибка на шаге загрузки: " + ОписаниеОшибки());
		Возврат;

	КонецПопытки;

	ТекущаяСтрокаExcel = РезультатПачки.СледующаяСтрока;
	ОбработаноСтрок = ОбработаноСтрок + РезультатПачки.Обработано;

	Если ВсегоСтрокДляПрогресса > 0 Тогда
		ПроцентЗагрузки = Окр((ОбработаноСтрок / ВсегоСтрокДляПрогресса) * 100, 0);
	Иначе
		ПроцентЗагрузки = 100;
	КонецЕсли;

	Если ПроцентЗагрузки > 100 Тогда
		ПроцентЗагрузки = 100;
	КонецЕсли;

	ТекстПрогресса = РежимЗагрузки 
		+ ": " + " обработано "
		+ Строка(ОбработаноСтрок) + " из "
		+ Строка(ВсегоСтрокДляПрогресса);

	// Даем форме обновиться и запускаем следующий шаг
	ПодключитьОбработчикОжидания("ВыполнитьШагЗагрузки", 0.1, Истина);

КонецПроцедуры

&НаСервере
Функция ОбработатьПачкуОСНаСервере(АдресТабДок, НачальнаяСтрока, КоличествоСтрокПачки)
    
    	СозданоОСВПачке = 0;
	СозданоИнвНомеровВПачке = 0;
	ПропущеноВПачке = 0;
	Ошибок = 0;
    
	ТабДок = ПолучитьИзВременногоХранилища(АдресТабДок);

	Если ТабДок = Неопределено Тогда
		ВызватьИсключение "Не удалось получить ТабличныйДокумент из временного хранилища.";
	КонецЕсли;

	ПоследняяСтрока = ТабДок.ВысотаТаблицы;
	Обработано = 0;
	Ошибок = 0;

	КонечнаяСтрока = НачальнаяСтрока + КоличествоСтрокПачки - 1;

	Если КонечнаяСтрока > ПоследняяСтрока Тогда
		КонечнаяСтрока = ПоследняяСтрока;
	КонецЕсли;

	Для НомерСтроки = НачальнаяСтрока По КонечнаяСтрока Цикл

		Попытка
			РезультатСтроки = СоздатьОСИИнвентарныйНомерПоСтрокеExcel(ТабДок, НомерСтроки); 
			
			СозданоОСВПачке = СозданоОСВПачке + РезультатСтроки.СозданоОС;
			СозданоИнвНомеровВПачке = СозданоИнвНомеровВПачке + РезультатСтроки.СозданоИнвНомеров;
			ПропущеноВПачке = ПропущеноВПачке + РезультатСтроки.Пропущено;
			
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("Ошибка создания ОС в строке " + НомерСтроки + ": " + ОписаниеОшибки());
		КонецПопытки;

		Обработано = Обработано + 1;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Обработано", Обработано);
	Результат.Вставить("СозданоОС", СозданоОСВПачке);
	Результат.Вставить("СозданоИнвНомеров", СозданоИнвНомеровВПачке);
	Результат.Вставить("Пропущено", ПропущеноВПачке);
	Результат.Вставить("Ошибок", Ошибок);
	Результат.Вставить("СледующаяСтрока", КонечнаяСтрока + 1);

	Возврат Результат;

КонецФункции

&НаСервере
Функция ОбработатьПачкуВводаОстатковНаСервере(АдресТабДок, НачальнаяСтрока, КоличествоСтрокПачки)

