&НаСервере
Функция ЧислоИзExcel(ЗначениеЯчейки)

	СтрокаЧисла = СокрЛП(Строка(ЗначениеЯчейки));

	Если ПустаяСтрока(СтрокаЧисла) Тогда
		Возврат 0;
	КонецЕсли;

	// Убираем обычные пробелы и неразрывные пробелы из Excel
	СтрокаЧисла = СтрЗаменить(СтрокаЧисла, " ", "");
	СтрокаЧисла = СтрЗаменить(СтрокаЧисла, Символ(160), "");

	// На всякий случай точку заменяем на запятую
	СтрокаЧисла = СтрЗаменить(СтрокаЧисла, ".", ",");

	Попытка
		Возврат Число(СтрокаЧисла);
	Исключение
		Сообщить("Не удалось преобразовать цену в число: " + ЗначениеЯчейки);
		Возврат 0;
	КонецПопытки;

КонецФункции  

&НаСервере
