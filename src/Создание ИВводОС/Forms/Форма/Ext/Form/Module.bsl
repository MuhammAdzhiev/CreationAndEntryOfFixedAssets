// Получает ссылку на зарегистрированную дополнительную обработку из параметров формы.
// Ссылка необходима для запуска фоновой команды через механизм БСП.
// Параметры:
//   Отказ, СтандартнаяОбработка - стандартные параметры события создания формы.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СсылкаОбработки = Неопределено;

	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", СсылкаОбработки) Тогда

		ДополнительнаяОбработкаСсылка = СсылкаОбработки;

	КонецЕсли;

КонецПроцедуры

// Команда создания основных средств и инвентарных номеров из Excel.
// Проверяет выбор организации и инициирует асинхронное помещение файла
// во временное хранилище; продолжение выполняется в ПослеПомещенияФайла().
&НаКлиенте
Процедура Загрузить(Команда)
    
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Сначала выберите организацию.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);

	Попытка

		НачатьПомещениеФайла(Оповещение,,, Истина, УникальныйИдентификатор);

	Исключение

		Сообщить("Ошибка при НачатьПомещениеФайла: " + ОписаниеОшибки());

	КонецПопытки;
		
КонецПроцедуры
 
// Обработчик завершения выбора и передачи Excel-файла для режима "ОС".
// Параметры:
//   Результат - признак успешного помещения файла.
//   Адрес - адрес Excel-файла во временном хранилище.
//   ВыбранноеИмяФайла, ДополнительныеПараметры - параметры оповещения платформы.
&НаКлиенте
Процедура ПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Сообщить("Файл не был выбран.");
		Возврат;
	КонецЕсли;

	Попытка
		ДанныеЗагрузки = ПодготовитьExcelКЗагрузкеНаСервере(Адрес);
	Исключение
		Сообщить("Ошибка подготовки Excel: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ПараметрыЗагрузки = СформироватьПараметрыЗагрузки("ОС", ДанныеЗагрузки.ДанныеExcelСтрокой);
	ЗапуститьЗагрузкуВФоне(ПараметрыЗагрузки);

КонецПроцедуры

// Команда создания документов ввода начальных остатков ОС.
// Проверяет общие реквизиты формы и запускает передачу Excel-файла.
// После помещения файла вызывается ПослеПомещенияФайлаДляВводаОстатков().
&НаКлиенте
Процедура СоздатьВводОстатков(Команда)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Сначала выберите организацию.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КПС) Тогда
		Сообщить("Сначала выберите КПС.");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПорядокПогашенияСтоимости) Тогда
		Сообщить("Сначала выберите порядок погашения стоимости.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайлаДляВводаОстатков", ЭтотОбъект);

	Попытка

		НачатьПомещениеФайла(Оповещение,,, Истина, УникальныйИдентификатор);

	Исключение
		Сообщить("Ошибка при передаче файла: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Обработчик завершения передачи файла для режима "Остатки".
// Передаёт адрес файла и настройки формы в механизм фоновой загрузки.
// Параметры аналогичны обработчику ПослеПомещенияФайла().
&НаКлиенте
Процедура ПослеПомещенияФайлаДляВводаОстатков(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Сообщить("Файл не был выбран.");
		Возврат;
	КонецЕсли;

	Попытка
		ДанныеЗагрузки = ПодготовитьExcelКЗагрузкеНаСервере(Адрес);
	Исключение
		Сообщить("Ошибка подготовки Excel: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ПараметрыЗагрузки = СформироватьПараметрыЗагрузки("Остатки", ДанныеЗагрузки.ДанныеExcelСтрокой);

	ЗапуститьЗагрузкуВФоне(ПараметрыЗагрузки);
	
КонецПроцедуры

// Получает Excel-файл из временного хранилища, считывает его содержимое и преобразует в таблицу значений для последующей 
// фоновой загрузки.
// Параметры:
//   АдресФайла - Строка - адрес Excel-файла во временном хранилище.
// Возвращаемое значение:
//   Структура - содержит поле "ДанныеExcelСтрокой" с сериализованной таблицей значений.
// Временный файл на сервере удаляется после чтения или при ошибке.
&НаСервере
Функция ПодготовитьExcelКЗагрузкеНаСервере(АдресФайла)
	
   	// Получаем двоичные данные загруженного Excel-файла.
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);

	Если ДвоичныеДанныеФайла = Неопределено Тогда
		ВызватьИсключение "Не удалось получить Excel-файл из временного хранилища.";
	КонецЕсли;
	
    	// Создаем временный файл на сервере для чтения Excel.
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ВременныйФайл = Новый Файл(ИмяВременногоФайла);

	Попытка
        	// Сохраняем полученные двоичные данные во временный файл.
		ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
		
        	// Считываем Excel в табличный документ 1С.
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Прочитать(ИмяВременногоФайла); 
		
        	// Преобразуем табличный документ в таблицу значений.
		ТаблицаДанных = ПреобразоватьТабДокВТаблицуДанных(ТабДок);
	Исключение
		// Сохраняем информацию об ошибке перед удалением файла.
		ИнформацияТекущейОшибки = ИнформацияОбОшибке();
		
        	// Удаляем временный файл при ошибке чтения или преобразования.
		Если ВременныйФайл.Существует() Тогда
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;

		ВызватьИсключение "Не удалось прочитать Excel: "+ КраткоеПредставлениеОшибки(ИнформацияТекущейОшибки);

	КонецПопытки;
	
	// Удаляем временный файл после успешного чтения.
	Если ВременныйФайл.Существует() Тогда
		УдалитьФайлы(ИмяВременногоФайла);
	КонецЕсли;
	
	// Сериализуем таблицу значений в строку для передачи параметром в фоновую операцию (отдельный серверный сеанс).
	Возврат Новый Структура("ДанныеExcelСтрокой", ЗначениеВСтрокуВнутр(ТаблицаДанных));
	
КонецФункции

// Переносит десять столбцов Excel из ТабДок в ТаблицаЗначений.
// Первая строка считается заголовком и не загружается.
// ВАЖНО: чтение заканчивается на первой строке, где одновременно пусты наименование ОС и инвентарный номер (даже если 
// ниже есть данные).
// Возвращаемое значение:
//   ТаблицаЗначений со строками, предназначенными для обработки.
&НаСервере
Функция ПреобразоватьТабДокВТаблицуДанных(ТабДок)

	ТаблицаДанных = Новый ТаблицаЗначений;

	ТаблицаДанных.Колонки.Добавить("НаименованиеОС");
	ТаблицаДанных.Колонки.Добавить("ИнвентарныйНомер");
	ТаблицаДанных.Колонки.Добавить("Количество");
	ТаблицаДанных.Колонки.Добавить("БалансоваяСтоимость");
	ТаблицаДанных.Колонки.Добавить("Амортизация");
	ТаблицаДанных.Колонки.Добавить("ОстаточнаяСтоимость");
	ТаблицаДанных.Колонки.Добавить("СчетУчета");
	ТаблицаДанных.Колонки.Добавить("ЦМО");
	ТаблицаДанных.Колонки.Добавить("ДатаПринятияКУчету");
	ТаблицаДанных.Колонки.Добавить("ДатаВводаВЭксплуатацию");

	Для НомерСтроки = 2 По ТабДок.ВысотаТаблицы Цикл

		СтрокаДанных = ТаблицаДанных.Добавить();

		СтрокаДанных.НаименованиеОС = ТабДок.Область(НомерСтроки, 1).Текст;
		СтрокаДанных.ИнвентарныйНомер = ТабДок.Область(НомерСтроки, 2).Текст;
		СтрокаДанных.Количество = ТабДок.Область(НомерСтроки, 3).Текст;
		СтрокаДанных.БалансоваяСтоимость = ТабДок.Область(НомерСтроки, 4).Текст;
		СтрокаДанных.Амортизация = ТабДок.Область(НомерСтроки, 5).Текст;
		СтрокаДанных.ОстаточнаяСтоимость = ТабДок.Область(НомерСтроки, 6).Текст;
		СтрокаДанных.СчетУчета = ТабДок.Область(НомерСтроки, 7).Текст;
		СтрокаДанных.ЦМО = ТабДок.Область(НомерСтроки, 8).Текст;
		СтрокаДанных.ДатаПринятияКУчету = ТабДок.Область(НомерСтроки, 9).Текст;
		СтрокаДанных.ДатаВводаВЭксплуатацию = ТабДок.Область(НомерСтроки, 10).Текст;

	КонецЦикла;

	Возврат ТаблицаДанных;

КонецФункции

// Собирает общие параметры запуска из полей формы.
// Параметры:
//   Режим - "ОС" или "Остатки".
//   ДанныеExcelСтрокой - строка с данными исходного Excel.
// Возвращаемое значение:
//   Структура - режим и общие реквизиты будущих объектов.
&НаКлиенте
Функция СформироватьПараметрыЗагрузки(Режим, ДанныеExcelСтрокой)

	ПараметрыЗагрузки = Новый Структура;

	ПараметрыЗагрузки.Вставить("Режим", Режим);
	ПараметрыЗагрузки.Вставить("ДанныеExcelСтрокой", ДанныеExcelСтрокой);
	ПараметрыЗагрузки.Вставить("Организация", Организация);
	ПараметрыЗагрузки.Вставить("КПС", КПС);
	ПараметрыЗагрузки.Вставить("ПорядокПогашенияСтоимости", ПорядокПогашенияСтоимости);
	ПараметрыЗагрузки.Вставить("НомерДокументаПринятияКУчету", НомерДокументаПринятияКУчету);
	ПараметрыЗагрузки.Вставить("НомерДокументаВводаВЭксплуатацию", НомерДокументаВводаВЭксплуатацию);
	ПараметрыЗагрузки.Вставить("ДатаДокументаПринятияКУчету", ДатаДокументаПринятияКУчету);
	ПараметрыЗагрузки.Вставить("ДатаДокументаВводаВЭксплуатацию",ДатаДокументаВводаВЭксплуатацию);
	ПараметрыЗагрузки.Вставить("НаименованиеДокументаПринятияКУчету", НаименованиеДокументаПринятияКУчету);
	ПараметрыЗагрузки.Вставить("НаименованиеДокументаВводаВЭксплуатацию", НаименованиеДокументаВводаВЭксплуатацию);

	Возврат ПараметрыЗагрузки;

КонецФункции

// Запускает серверную команду обработки как длительную операцию БСП.
// Параметры:
//   ПараметрыЗагрузки - структура общих настроек и данные Excel-файла.
// По завершении БСП вызывает ПослеЗавершенияЗагрузкиВФоне().
&НаКлиенте
Процедура ЗапуститьЗагрузкуВФоне(ПараметрыЗагрузки)

	Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда

		Сообщить("Обработка должна быть открыта " + "из списка дополнительных отчётов " + "и обработок.");

		Возврат;

	КонецЕсли;

	ПараметрыКоманды = ДополнительныеОтчетыИОбработкиКлиент.ПараметрыВыполненияКомандыВФоне(ДополнительнаяОбработкаСсылка);
	
	// Просим БСП вернуть результат серверной команды для итогового сообщения.
	ПараметрыКоманды.Вставить("ПолучатьРезультат", Истина);
	
	Если ПараметрыЗагрузки.Режим = "ОС" Тогда

		ПараметрыКоманды.СопровождающийТекст = "Создание основных средств " + "и инвентарных номеров";

	Иначе

		ПараметрыКоманды.СопровождающийТекст = "Создание документов " + "ввода начальных остатков";

	КонецЕсли;

	ПараметрыКоманды.ФормаВладелец = ЭтотОбъект;

	// Данные Excel и общие реквизиты передаются серверной команде как параметры.
	ПараметрыКоманды.Вставить("ПараметрыЗагрузки", ПараметрыЗагрузки);

	ОбработчикЗавершения = Новый ОписаниеОповещения("ПослеЗавершенияЗагрузкиВФоне", ЭтотОбъект);

	ДополнительныеОтчетыИОбработкиКлиент.ВыполнитьКомандуВФоне("ВыполнитьЗагрузкуВФоне", ПараметрыКоманды, 
			ОбработчикЗавершения);

КонецПроцедуры
		
// Обрабатывает уведомление БСП о завершении фоновой загрузки.
// Проверяет статус операции, извлекает вложенный результат и выводит
// количество созданных, пропущенных и ошибочных строк с текстами ошибок.
// Параметры:
//   РезультатОперации - служебная структура БСП / результат команды.
//   ДополнительныеПараметры - параметры оповещения платформы.
&НаКлиенте
Процедура ПослеЗавершенияЗагрузкиВФоне(РезультатОперации, ДополнительныеПараметры) Экспорт

	Если РезультатОперации = Неопределено Тогда

		Сообщить("Выполнение загрузки отменено.");

		Возврат;

	КонецЕсли;

	Если ТипЗнч(РезультатОперации) <> Тип("Структура") Тогда

		Сообщить("Получен неизвестный результат длительной операции: " + Строка(ТипЗнч(РезультатОперации)));

		Возврат;

	КонецЕсли;

	// Сначала разбираем статус самой длительной операции, затем её результат.
	СтатусОперации = Неопределено;

	Если РезультатОперации.Свойство("Статус", СтатусОперации) Тогда

		Если СтатусОперации <> "Выполнено" Тогда

			ТекстОшибки = "";

			РезультатОперации.Свойство("КраткоеПредставлениеОшибки", ТекстОшибки);

			Если ПустаяСтрока(ТекстОшибки) Тогда

				РезультатОперации.Свойство("ПодробноеПредставлениеОшибки", ТекстОшибки);

			КонецЕсли;

			Если ПустаяСтрока(ТекстОшибки) Тогда
				ТекстОшибки = "Длительная операция завершилась со статусом: " + Строка(СтатусОперации);
			КонецЕсли;

			Сообщить(ТекстОшибки);

			Возврат;

		КонецЕсли;

	КонецЕсли;

	РезультатЗагрузки = Неопределено;
	
	// В зависимости от варианта вызова БСП результат бывает вложенным.
	Если Не РезультатОперации.Свойство("Результат", РезультатЗагрузки) Тогда

		РезультатЗагрузки = РезультатОперации;

	КонецЕсли;

	РезультатВыполнения = Неопределено;
	
	// Объектный модуль сохраняет полезный результат в поле "РезультатВыполнения".
	Если ТипЗнч(РезультатЗагрузки) = Тип("Структура") И РезультатЗагрузки.Свойство("РезультатВыполнения", 
			РезультатВыполнения) Тогда

		РезультатЗагрузки =РезультатВыполнения;

	КонецЕсли;

	Если ТипЗнч(РезультатЗагрузки)<> Тип("Структура") Тогда

		Сообщить("Фоновая загрузка завершилась, " + "но не вернула структуру результата.");

		Возврат;

	КонецЕсли;

	РежимЗагрузки = "";

	Если Не РезультатЗагрузки.Свойство("Режим", РежимЗагрузки) Тогда

		Сообщить("В результате фоновой загрузки " + "отсутствует поле ""Режим"".");

		Возврат;

	КонецЕсли;

	Если РежимЗагрузки = "ОС" Тогда

		СозданоОС = 0;
		СозданоИнвНомеров = 0;

		РезультатЗагрузки.Свойство("СозданоОС", СозданоОС);

		РезультатЗагрузки.Свойство("СозданоИнвНомеров", СозданоИнвНомеров);

		Сообщить("Создано ОС: " + Строка(СозданоОС));

		Сообщить("Создано инвентарных номеров: " + Строка(СозданоИнвНомеров));

	ИначеЕсли РежимЗагрузки = "Остатки" Тогда

		СозданоДокументов = 0;

		РезультатЗагрузки.Свойство("СозданоДокументов", СозданоДокументов);

		Сообщить("Создано документов: " + Строка(СозданоДокументов));

	Иначе

		Сообщить("Неизвестный режим загрузки: " + РежимЗагрузки);

	КонецЕсли;

	Пропущено = 0;
	Ошибок = 0;

	РезультатЗагрузки.Свойство("Пропущено", Пропущено);
	РезультатЗагрузки.Свойство("Ошибок", Ошибок);

	Сообщить("Пропущено строк: " + Строка(Пропущено));
	Сообщить(	"Ошибок: " + Строка(Ошибок));

