&НаСервере
Функция СоздатьОСИИнвентарныйНомерПоСтрокеExcel(ТабДок, НомерСтроки)

	Результат = Новый Структура;
	Результат.Вставить("СозданоОС", 0);
	Результат.Вставить("СозданоИнвНомеров", 0);
	Результат.Вставить("Пропущено", 0);

	НаименованиеОС = СокрЛП(ТабДок.Область(НомерСтроки, 1).Текст); 
	
	НаименованиеОС = СтрЗаменить(НаименованиеОС, Символы.ПС, " ");
	НаименованиеОС = СтрЗаменить(НаименованиеОС, Символы.ВК, " ");
	НаименованиеОС = СтрЗаменить(НаименованиеОС, Символы.ВТаб, " ");
	
	Если Лев(НаименованиеОС, 1) = "." Тогда
		НаименованиеОС = СокрЛП(Сред(НаименованиеОС, 2));
	КонецЕсли;
	
	Пока Найти(НаименованиеОС, "  ") > 0 Цикл
		НаименованиеОС = СтрЗаменить(НаименованиеОС, "  ", " ");
	КонецЦикла;

	НаименованиеОС = СокрЛП(НаименованиеОС);
	
	ИнвентарныйНомер = СокрЛП(Строка(ТабДок.Область(НомерСтроки, 2).Текст));

	ИнвентарныйНомер = СтрЗаменить(ИнвентарныйНомер, Символ(160), "");
	ИнвентарныйНомер = СтрЗаменить(ИнвентарныйНомер, " ", "");
	ИнвентарныйНомер = СтрЗаменить(ИнвентарныйНомер, Символы.Таб, "");

	Если ПустаяСтрока(НаименованиеОС) Тогда
		Результат.Пропущено = 1;
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(ИнвентарныйНомер) Тогда
		ВызватьИсключение "Строка " + НомерСтроки + ": не заполнен инвентарный номер.";
	КонецЕсли;

	Если СтрДлина(ИнвентарныйНомер) < 10 Тогда
		ИнвентарныйНомер = Прав("0000000000" + ИнвентарныйНомер, 10);
	КонецЕсли;

	СуществующийИнвНомер = НайтиИнвентарныйНомер(ИнвентарныйНомер);

	Если ЗначениеЗаполнено(СуществующийИнвНомер) Тогда
		Результат.Пропущено = 1;
		Возврат Результат;
	КонецЕсли;

	НовоеОС = Справочники.ОсновныеСредства.СоздатьЭлемент();

	НовоеОС.Наименование = Лев(НаименованиеОС, 150);
	НовоеОС.Организация = Организация;
	НовоеОС.ВидНФА = Перечисления.ВидыНФА.ОС;
	НовоеОС.ТипНФА = Перечисления.ТипыНФА.Инвентарь;

	Если ЕстьРеквизитОбъекта(НовоеОС, "ПолноеНаименование") Тогда
		НовоеОС["ПолноеНаименование"] = НаименованиеОС;
	КонецЕсли;

	НовоеОС.Записать();

	СсылкаОС = НовоеОС.Ссылка;
	Результат.СозданоОС = 1;

	НовыйИнвНомер = Справочники.ИнвентарныеНомераОС.СоздатьЭлемент();

	НовыйИнвНомер.Владелец = Организация;
	НовыйИнвНомер.ОС = СсылкаОС;
	НовыйИнвНомер.Код = ИнвентарныйНомер;

	НовыйИнвНомер.Записать();

	Результат.СозданоИнвНомеров = 1;

	Возврат Результат;

КонецФункции

&НаСервере
Функция СоздатьВводОстатковПоСтрокеExcel(ТабДок, НомерСтроки)
     
     	Результат = Новый Структура;
	Результат.Вставить("СозданоДокументов", 0);
	Результат.Вставить("Пропущено", 0);
     
	НаименованиеОС = СокрЛП(ТабДок.Область(НомерСтроки, 1).Текст);
	ИнвентарныйНомер = СокрЛП(ТабДок.Область(НомерСтроки, 2).Текст);

	КоличествоСтрокой = СокрЛП(ТабДок.Область(НомерСтроки, 3).Текст);
	БалСтоимостьСтрокой = СокрЛП(ТабДок.Область(НомерСтроки, 4).Текст);
	АмортизацияСтрокой = СокрЛП(ТабДок.Область(НомерСтроки, 5).Текст);
	ОстСтоимостьСтрокой = СокрЛП(ТабДок.Область(НомерСтроки, 6).Текст);

	Если ПустаяСтрока(НаименованиеОС) Тогда
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(ИнвентарныйНомер) Тогда
		Сообщить("Строка " + НомерСтроки + ": не заполнен инвентарный номер, строка пропущена.");
		Результат.Пропущено = 1;
		Возврат Результат;
	КонецЕсли;

	Если СтрДлина(ИнвентарныйНомер) < 10 Тогда
		ИнвентарныйНомер = Прав("0000000000" + ИнвентарныйНомер, 10);
	КонецЕсли;

	Количество = ЧислоИзExcel(КоличествоСтрокой);
	БалансоваяСтоимость = ЧислоИзExcel(БалСтоимостьСтрокой);
	Амортизация = ЧислоИзExcel(АмортизацияСтрокой);
	ОстаточнаяСтоимость = ЧислоИзExcel(ОстСтоимостьСтрокой);

	СсылкаИнвНомера = НайтиИнвентарныйНомерОСПоКоду(ИнвентарныйНомер);

	Если Не ЗначениеЗаполнено(СсылкаИнвНомера) Тогда
		Сообщить("Строка " + НомерСтроки + ": не найден инвентарный номер " + ИнвентарныйНомер + ", строка пропущена.");
		Результат.Пропущено = 1;
		Возврат Результат;
	КонецЕсли;

	СсылкаОС = ПолучитьОсновноеСредствоИзИнвентарногоНомера(СсылкаИнвНомера);

	Если Не ЗначениеЗаполнено(СсылкаОС) Тогда
		Сообщить("Строка " + НомерСтроки + ": у инвентарного номера не заполнено основное средство, строка пропущена.");
		Результат.Пропущено = 1;
		Возврат Результат;
	КонецЕсли;
    
    	СуществующийВводОстатков = ЕстьВводОстатковПоОСИИнвНомеру(СсылкаОС, СсылкаИнвНомера);

	Если ЗначениеЗаполнено(СуществующийВводОстатков) Тогда

		Результат.Пропущено = 1;
		Возврат Результат;

	КонецЕсли;
    
	Попытка

		// =====================================================
		// 1 строка Excel = 1 новый документ
		// =====================================================

		ДокументОстатков = Документы.ВводНачальныхОстатковОС.СоздатьДокумент();

		ДокументОстатков.Дата = ТекущаяДата();

		// ==============================
		// ШАПКА ДОКУМЕНТА
		// ==============================

		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "Организация", Организация); 
		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "СчетУчета", Счет);
		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "ИФО", ИФО);
		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "КПС", КПС);
		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "КФО", КФО);

		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "ОсновноеСредство", СсылкаОС);
		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "ИнвентарныйНомер", СсылкаИнвНомера); 
		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "ОтражатьВБухгалтерскомУчете", Истина); 

		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "ДатаПринятияКУчету", ДатаПринятияКУчету);
		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "ДокументПринятияНомер", НомерДокументаПринятияКУчету);
		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "ДокументПринятияДата", ДатаДокументаПринятияКУчету);
		УстановитьРеквизитЕслиЕсть(ДокументОстатков, "ДокументПринятияВид", НаименованиеДокументаПринятияКУчету);

		// Если цена/стоимость находится в шапке документа
		ЗаполнитьСтоимостьВШапке(
			ДокументОстатков,
			БалансоваяСтоимость,
			Амортизация,
			ОстаточнаяСтоимость,
			Количество
		);

		// ==============================
		// ТАБЛИЧНАЯ ЧАСТЬ
		// ==============================

		НоваяСтрока = ДокументОстатков.ИнвентарныеОбъекты.Добавить();

		// В каждом документе только одна строка
		УстановитьРеквизитЕслиЕсть(НоваяСтрока, "ОсновноеСредство", СсылкаОС);
		УстановитьРеквизитЕслиЕсть(НоваяСтрока, "ИнвентарныйНомер", СсылкаИнвНомера);

		УстановитьРеквизитЕслиЕсть(НоваяСтрока, "ЦМО", ЦМО);  
		
		УстановитьРеквизитЕслиЕсть(НоваяСтрока, "ДатаВводаВЭксплуатацию", ДатаВводаВЭксплуатацию);
        		УстановитьРеквизитЕслиЕсть(НоваяСтрока, "ДокументВводаНомер", НомерДокументаВводаВЭксплуатацию);
        		УстановитьРеквизитЕслиЕсть(НоваяСтрока, "ДокументВводаДата", ДатаДокументаВводаВЭксплуатацию);
        		УстановитьРеквизитЕслиЕсть(НоваяСтрока, "ДокументВводаВид", НаименованиеДокументаВводаВЭксплуатацию);
		
		УстановитьРеквизитЕслиЕсть(НоваяСтрока, "СостояниеОСвОрганизации", "БалансВведеноВЭксплуатацию");
		УстановитьРеквизитЕслиЕсть(НоваяСтрока, "СостояниеОС", ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию"));
		УстановитьРеквизитЕслиЕсть(НоваяСтрока, "НаСчете21", Ложь);  
		
		// Если цена/стоимость находится в табличной части
		ЗаполнитьСтоимостьВСтрокеИнвОбъекты(
			НоваяСтрока,
			БалансоваяСтоимость,
			Амортизация,
			ОстаточнаяСтоимость,
			Количество
		);
         
         	НоваяСтрока = ДокументОстатков.СтоимостьИАмортизация.Добавить();
        	УстановитьРеквизитЕслиЕсть(НоваяСтрока, "ПорядокПогашенияСтоимости", ПорядокПогашенияСтоимости);  
                                                                                     
                                                                                     
	             // Добавление автоматического формирования бухгалтерских проводок
		ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатковОС_ВводНачальныхОстатковОС;
		ДополнительныеРеквизиты = Новый Структура;
		БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(ДокументОстатков, ТиповаяОперация, ДополнительныеРеквизиты, Истина);
		
		ДокументОстатков.Записать(РежимЗаписиДокумента.Запись);
		ДокументОстатков.Записать(РежимЗаписиДокумента.Проведение);
		
		ТаблицаПроводок = Обработки.ФормированиеБухгалтерскихПроводок.СформироватьТаблицуПроводок(ДокументОстатков.Ссылка);
		Если ТаблицаПроводок <> Неопределено И ТаблицаПроводок.Количество() > 0 Тогда
			Отказ = Ложь;
			БухгалтерскиеОперацииСервер.ЗагрузитьПроводкиДокумента(ДокументОстатков.Ссылка, ТаблицаПроводок, Отказ);
		КонецЕсли;

        	ДокументОстатков.Записать(РежимЗаписиДокумента.Запись);
		ДокументОстатков.Записать(РежимЗаписиДокумента.Проведение);  
		
						         
		Результат.СозданоДокументов = 1; 
		
       	Возврат Результат; 
       	 
	Исключение

		ВызватьИсключение "Ошибка в строке Excel " + НомерСтроки + ": " + ОписаниеОшибки();

	КонецПопытки; 
    
    	Возврат Результат;
    	
КонецФункции

&НаСервере
Функция НайтиИнвентарныйНомерОС(ИнвентарныйНомер, СсылкаОС)

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнвентарныеНомераОС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Владелец = &Организация
	|	И ИнвентарныеНомераОС.ОС = &ОС
	|	И ИнвентарныеНомераОС.Код = &Код";

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОС", СсылкаОС);
	Запрос.УстановитьПараметр("Код", ИнвентарныйНомер);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ЕстьВводОстатковПоОСИИнвНомеру(СсылкаОС, СсылкаИнвНомера)

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнвентарныеОбъекты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС.ИнвентарныеОбъекты КАК ИнвентарныеОбъекты
	|ГДЕ
	|	ИнвентарныеОбъекты.Ссылка.Организация = &Организация
	|	И ИнвентарныеОбъекты.Ссылка.ОсновноеСредство = &ОсновноеСредство
	|	И ИнвентарныеОбъекты.ИнвентарныйНомер = &ИнвентарныйНомер
	|	И НЕ ИнвентарныеОбъекты.Ссылка.ПометкаУдаления";

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", СсылкаОС);
	Запрос.УстановитьПараметр("ИнвентарныйНомер", СсылкаИнвНомера);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции